# Needed for GET /api/users and PATCH /api/users/:id. Unset = those endpoints always return 401.
ADMIN_TOKEN=

# Optional locally (dev uses in-memory storage). Required in any deployed environment.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. GTM container (GTM-XXXX). Unset = no third-party script loads; events stay in window.dataLayer.
PUBLIC_GTM_ID=
# Optional. Public URL, used for canonical and og:url.
SITE_URL=
# Optional. "true" only for a real launch; the demo deploy is noindex.
PUBLIC_INDEXABLE=
