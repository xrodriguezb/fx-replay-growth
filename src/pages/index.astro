---
import Base from '../layouts/Base.astro';
import ReplayDiptych from '../components/ReplayDiptych.astro';
import SignupForm from '../components/SignupForm';
import Wordmark from '../components/Wordmark.astro';

const steps = [
  { title: 'Pick a market and a date', text: 'Forex, futures, stocks, indices or crypto, on real historical price data.' },
  { title: 'Step forward bar by bar', text: 'Move one bar at a time, pause whenever you like, and decide what you’d do next.' },
  { title: 'Trade it like it’s live', text: 'Place your entries and exits, then keep stepping and see how your decisions hold up.' },
];
---

<Base
  title="Try FX Replay Free: practice trading on real market history"
  description="Replay real historical price data bar by bar and practice trading decisions without risking real money. Try FX Replay free."
>
  <header class="site-header">
    <div class="wrap">
      <a href="/" class="site-header__logo" aria-label="FX Replay home"><Wordmark class="wordmark" /></a>
    </div>
  </header>

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero__grid">
        <div class="hero__copy">
          <h1 id="hero-title">Practice the market before you risk a dollar.</h1>
          <p class="hero__lead">
            FX Replay plays back real price history one bar at a time. You trade it as if it were live, deciding with
            only what you’d have known in the moment.
          </p>
          <p class="hero__proof">Used by over 1 million traders</p>
        </div>
        <div class="hero__form" id="signup">
          <SignupForm client:load />
        </div>
      </div>
    </section>

    <section class="compare" aria-labelledby="compare-title">
      <div class="wrap">
        <h2 id="compare-title" class="section-title">Hindsight makes every chart look easy.</h2>
        <ReplayDiptych />
      </div>
    </section>

    <section class="steps" aria-labelledby="steps-title">
      <div class="wrap steps__grid">
        <h2 id="steps-title" class="section-title">How replay practice works</h2>
        <ol class="steps__list">
          {
            steps.map((step) => (
              <li>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="close" aria-labelledby="close-title">
      <div class="wrap close__inner">
        <h2 id="close-title" class="section-title">Make your next trade a practice one.</h2>
        <a class="btn" href="#signup" data-track-cta="final_cta">Try FX Replay Free</a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap site-footer__inner">
      <Wordmark class="wordmark" />
      <p>
        Demo built for a FX Replay hiring challenge. Signups here save a signup record, not an FX Replay account.
      </p>
      <p>Trader count as published on fxreplay.com (November 2026).</p>
      <p>Trading involves risk. Practice results don’t guarantee future performance.</p>
    </div>
  </footer>
</Base>

<style>
  .site-header {
    border-bottom: 1px solid var(--border-primary);
  }
  .site-header .wrap {
    display: flex;
    align-items: center;
    min-height: 4rem;
  }
  .site-header__logo {
    display: inline-flex;
    color: var(--text-primary);
  }
  /* the svg lives in Wordmark.astro, so scoped styles need :global to reach it */
  .site-header__logo :global(.wordmark),
  .site-footer :global(.wordmark) {
    height: 1.125rem;
    width: auto;
    display: block;
  }
  .site-footer :global(.wordmark) {
    height: 0.875rem;
    color: var(--text-disabled);
  }

  .hero {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 3vw, 2.5rem);
  }
  .hero__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  @media (min-width: 56rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(20rem, 1fr);
    }
  }
  .hero h1 {
    font-size: clamp(2.5rem, 1.6rem + 4vw, 4.75rem);
    max-width: 13ch;
  }
  .hero__lead {
    margin-top: 1.5rem;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    max-width: 44ch;
  }
  .hero__proof {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .hero__proof::before {
    content: '';
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--text-secondary);
    flex: none;
  }

  .section-title {
    font-size: clamp(1.75rem, 1.3rem + 2vw, 2.75rem);
    margin-bottom: clamp(1rem, 2.5vw, 1.5rem);
    max-width: 22ch;
  }

  .compare {
    padding-block: clamp(1rem, 2vw, 1.5rem) clamp(2rem, 5vw, 4rem);
  }

  .steps {
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  @media (min-width: 56rem) {
    .steps__grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: 4rem;
      align-items: start;
    }
  }
  .steps__list {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
    display: grid;
    gap: 0;
  }
  .steps__list li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    column-gap: 1rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--border-primary);
  }
  .steps__list li:last-child {
    border-bottom: 1px solid var(--border-primary);
  }
  .steps__list li::before {
    content: counter(step);
    grid-row: span 2;
    font: 900 1.25rem/1.2 var(--font-display);
    color: var(--text-disabled);
  }
  .steps__list h3 {
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }
  .steps__list p {
    margin-top: 0.375rem;
    max-width: 52ch;
  }

  .close {
    padding-block: clamp(3rem, 7vw, 6rem);
    border-top: 1px solid var(--border-primary);
    background: var(--bg-secondary);
  }
  .close__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .close .section-title {
    margin: 0;
  }

  .site-footer {
    padding-block: 2.5rem;
    border-top: 1px solid var(--border-primary);
    font-size: 0.875rem;
    color: var(--text-disabled);
  }
  .site-footer__inner {
    display: grid;
    gap: 0.75rem;
  }
</style>
